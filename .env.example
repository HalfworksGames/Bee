# Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_bot_token_here

# Local llama.cpp / llama serve URL
LLAMA_SERVER_URL=http://127.0.0.1:8080

# Model name (matches model ID in llama serve)
MODEL_NAME=schizophyllume/beellm

# Queue configuration
QUEUE_SIZE=16

# LLM generation settings
MAX_TOKENS=128
TEMPERATURE=0.7
TOP_P=0.9

# Number of message turns to remember per channel (for Bee to hold grudges, remember flowers, etc.)
HISTORY_LIMIT=6

# Set to true to ping user on reply, false for unpinged reply
REPLY_AS_MENTION=false

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
